# Set to false only when you are deliberately ready to trade with real capital.
KALSHI_DEMO_MODE=true

KALSHI_DEMO_API_KEY_ID=your-demo-api-key-id
KALSHI_DEMO_API_KEY_FILE=/path/to/demo_key.pem
KALSHI_DEMO_BASE_URL=https://external-api.demo.kalshi.co/trade-api/v2
KALSHI_DEMO_WS_URL=wss://external-api-ws.demo.kalshi.co/trade-api/ws/v2

KALSHI_LIVE_API_KEY_ID=your-live-api-key-id
KALSHI_LIVE_API_KEY_FILE=/path/to/live_key.pem
KALSHI_BASE_URL=https://external-api.kalshi.com/trade-api/v2
KALSHI_WS_URL=wss://external-api-ws.kalshi.com/trade-api/ws/v2

RFQ_FEE_BUFFER=0.02
RFQ_MAX_EXPOSURE_PCT_PER_CONTRACT=0.01
RFQ_MAX_EXPOSURE_PCT_PER_PREFIX=0.03
RFQ_RESPONSE_DEADLINE_S=0.75
# Bounds concurrent RFQ processing so a burst can't fan out into hundreds of concurrent HTTP
# requests and exhaust the connection pool.
RFQ_MAX_CONCURRENT_PROCESSING=20
# Paces outbound REST calls (separate read/write buckets, matching Kalshi's actual model).
# Confirmed tiers: Basic 200/100 tokens/sec, Advanced (free, auto-upgraded at bot startup)
# 300/300, most requests cost 10 tokens -- these sit at 80% of Advanced's ~30 req/s, safely
# under Basic too in case the upgrade call ever fails.
RFQ_MAX_READ_REQUESTS_PER_SECOND=24.0
RFQ_MAX_WRITE_REQUESTS_PER_SECOND=24.0

# Absolute dollar floor under the two caps above. At a small bankroll, a pure percentage cap
# can round to smaller than a single realistic contract's liability and reject nearly every
# quote. 0.0 = no floor (pure percentage). Set these deliberately for your actual bankroll --
# there's no universal "right" default, so this is left off unless you configure it.
RFQ_MIN_NOTIONAL_CAP_PER_CONTRACT_USD=0.0
RFQ_MIN_NOTIONAL_CAP_PER_PREFIX_USD=0.0

# Refuse combos where two or more legs share the same underlying event (same-game parlays).
# Those legs are typically correlated, which the independence-based floor doesn't price in.
RFQ_MGP_ONLY=true

# Extra fee_buffer per leg beyond RFQ_FEE_BUFFER_BASE_LEGS (independence error compounds with
# leg count). 0.0 = no scaling; there's no empirically-calibrated "right" value here, so this
# is left off by default rather than guessed.
RFQ_FEE_BUFFER_PER_EXTRA_LEG=0.0
RFQ_FEE_BUFFER_BASE_LEGS=2

# Reject a leg's price if its top-of-book size on either side is thinner than this many
# contracts -- guards against a single stale/leftover resting order skewing the price.
RFQ_MIN_LEG_QUOTE_SIZE=5

# How long to wait for a quote_accepted event before giving up and releasing reserved
# liability. Not the exchange's own confirm window (3-30s, handled immediately on acceptance)
# -- this is just the safety-net timeout for "never got accepted at all."
RFQ_QUOTE_ACCEPTANCE_TIMEOUT_S=120
# How long to remember an rfq_id for duplicate-event suppression (WS redelivery on reconnect).
RFQ_SEEN_TTL_S=3600

# Fallback only -- live cash balance is fetched from Kalshi and refreshed periodically.
RFQ_BANKROLL_USD=100
RFQ_BANKROLL_REFRESH_INTERVAL_S=30

# 0 disables the stop-loss halt. Basis is cash balance only (no mark-to-market of open positions).
RFQ_STOP_LOSS_FLOOR_USD=0

# Slack-compatible webhook URL for critical alerts (stop-loss, startup reconciliation failure,
# prolonged WS outage, failed quote confirmation). Leave unset to disable alerting.
RFQ_ALERT_WEBHOOK_URL=

# Local read-only web dashboard (live feed of RFQ/quote activity + bankroll/exposure).
# Binds to localhost only by default -- widen only if you understand who else is on the network.
RFQ_DASHBOARD_HOST=127.0.0.1
RFQ_DASHBOARD_PORT=8765
